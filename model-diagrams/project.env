# model-diagrams' settings for labbook submit and the cluster queue: its one job, modeldiagram.vlm_job,
# makes a vision-language model's values (experiments/01-vlm-values/README.md). Submitting, the job script
# and the shared model copy live in labbook; this folder keeps only this file, .model.env (private; copy
# model.env.example) and jobs/requirements.txt, from which its venv is built. labbook submit runs from
# this folder (Learn-AI/model-diagrams), so this folder is the project's root.
PROJECT=model-diagrams
# its own venv on work, built from jobs/requirements.txt: transformers 5.20 or newer, which introspection's may not have
ENV=/sc/arion/scratch/$USER/venvs/model-diagrams-venv
MODULES=python/3.10.17
QUEUE=gpuexpress
WALLTIME=60
ACCOUNT=acc_rg_HPIMS
CORES=4
# one 80 GB GPU: the model in bfloat16 is 19 GB, and vision block 1's 16 heads over 2,880 patches are 0.5 GB each way
RESOURCES="select[(a10080g||h10080g||h100nvl) && hname!=lg05g29] span[hosts=1] rusage[mem=64000]"
